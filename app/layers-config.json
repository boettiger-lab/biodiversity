{
    "version": "1.0",
    "description": "Map layer configuration for wetlands biodiversity application",
    "layers": {
        "wetlands": {
            "displayName": "Global Wetlands (GLWD)",
            "layerIds": [
                "wetlands-layer"
            ],
            "checkboxId": "wetlands-layer",
            "hasLegend": true,
            "isVector": false,
            "sourceUrl": "pmtiles://https://s3-west.nrp-nautilus.io/public-pmtiles/glwd.pmtiles",
            "dataTablePath": "s3://public-wetlands/glwd/hex/**",
            "description": "Global Lakes and Wetlands Database (GLWD) showing wetland types worldwide"
        },
        "ncp": {
            "displayName": "Nature's Contributions to People",
            "layerIds": [
                "ncp-layer"
            ],
            "checkboxId": "ncp-layer",
            "hasLegend": false,
            "isVector": false,
            "sourceUrl": "pmtiles://https://s3-west.nrp-nautilus.io/public-pmtiles/ncp.pmtiles",
            "dataTablePath": "s3://public-ncp/hex/ncp_biod_nathab/**",
            "description": "Areas of greatest biodiversity contribution to people (0-1 score)"
        },
        "carbon": {
            "displayName": "Vulnerable Carbon",
            "layerIds": [
                "carbon-layer"
            ],
            "checkboxId": "carbon-layer",
            "hasLegend": false,
            "isVector": false,
            "sourceUrl": "pmtiles://https://s3-west.nrp-nautilus.io/public-pmtiles/carbon.pmtiles",
            "dataTablePath": "s3://public-carbon/hex/vulnerable-carbon/**",
            "description": "Above and below-ground carbon vulnerable to release from development"
        },
        "ramsar": {
            "displayName": "Ramsar Wetland Sites",
            "layerIds": [
                "ramsar-layer",
                "ramsar-outline"
            ],
            "checkboxId": "ramsar-layer",
            "hasLegend": false,
            "isVector": true,
            "sourceLayer": "ramsar",
            "sourceUrl": "pmtiles://https://s3-west.nrp-nautilus.io/public-pmtiles/ramsar.pmtiles",
            "dataTablePath": "s3://public-wetlands/ramsar/hex/**",
            "description": "Wetlands of International Importance under the Ramsar Convention",
            "filterableProperties": {
                "ramsarid": {
                    "type": "number",
                    "description": "Unique Ramsar site ID"
                },
                "Site name": {
                    "type": "string",
                    "description": "Official site name"
                },
                "officialna": {
                    "type": "string",
                    "description": "Official site name (legacy field)"
                },
                "Region": {
                    "type": "string",
                    "description": "Geographic region"
                },
                "Country": {
                    "type": "string",
                    "description": "Country name"
                },
                "Territory": {
                    "type": "string",
                    "description": "Territory name"
                },
                "iso3": {
                    "type": "string",
                    "description": "ISO 3-letter country code"
                },
                "country_en": {
                    "type": "string",
                    "description": "Country name in English"
                },
                "Designation date": {
                    "type": "string",
                    "description": "Date of Ramsar designation"
                },
                "Last publication date": {
                    "type": "string",
                    "description": "Last update date"
                },
                "Area (ha)": {
                    "type": "number",
                    "description": "Area in hectares"
                },
                "area_off": {
                    "type": "number",
                    "description": "Official area in hectares (legacy field)"
                },
                "Latitude": {
                    "type": "number",
                    "description": "Latitude coordinate"
                },
                "Longitude": {
                    "type": "number",
                    "description": "Longitude coordinate"
                },
                "Annotated summary": {
                    "type": "string",
                    "description": "Site description"
                },
                "Criterion1": {
                    "type": "boolean",
                    "description": "Criterion 1: Representative/rare wetland type"
                },
                "Criterion2": {
                    "type": "boolean",
                    "description": "Criterion 2: Supports vulnerable species"
                },
                "Criterion3": {
                    "type": "boolean",
                    "description": "Criterion 3: Maintains biodiversity"
                },
                "Criterion4": {
                    "type": "boolean",
                    "description": "Criterion 4: Supports critical life stages"
                },
                "Criterion5": {
                    "type": "boolean",
                    "description": "Criterion 5: Supports 20,000+ waterbirds"
                },
                "Criterion6": {
                    "type": "boolean",
                    "description": "Criterion 6: Supports 1% of waterbird population"
                },
                "Criterion7": {
                    "type": "boolean",
                    "description": "Criterion 7: Supports indigenous fish"
                },
                "Criterion8": {
                    "type": "boolean",
                    "description": "Criterion 8: Fish spawning/nursery"
                },
                "Criterion9": {
                    "type": "boolean",
                    "description": "Criterion 9: Supports 1% of non-avian species"
                },
                "Wetland Type": {
                    "type": "string",
                    "description": "Type of wetland ecosystem"
                },
                "Maximum elevation": {
                    "type": "number",
                    "description": "Maximum elevation in meters"
                },
                "Minimum elevation": {
                    "type": "number",
                    "description": "Minimum elevation in meters"
                },
                "Montreux listed": {
                    "type": "boolean",
                    "description": "Whether site is on Montreux Record"
                },
                "Management plan implemented": {
                    "type": "boolean",
                    "description": "Management plan status"
                },
                "Management plan available": {
                    "type": "boolean",
                    "description": "Management plan availability"
                },
                "Ecosystem services": {
                    "type": "string",
                    "description": "Description of ecosystem services"
                },
                "Threats": {
                    "type": "string",
                    "description": "Documented threats to site"
                },
                "large administrative region": {
                    "type": "string",
                    "description": "Large administrative region"
                },
                "Global international legal designations": {
                    "type": "string",
                    "description": "Global legal designations"
                },
                "Regional international legal designations": {
                    "type": "string",
                    "description": "Regional legal designations"
                },
                "National conservation designation": {
                    "type": "string",
                    "description": "National conservation status"
                },
                "Does the wetland extend onto the territory of one or more other countries?": {
                    "type": "boolean",
                    "description": "Transboundary status"
                },
                "Ramsar Advisory Mission?": {
                    "type": "boolean",
                    "description": "Whether advisory mission conducted"
                }
            }
        },
        "wdpa": {
            "displayName": "Protected Areas (WDPA)",
            "layerIds": [
                "wdpa-layer"
            ],
            "checkboxId": "wdpa-layer",
            "hasLegend": false,
            "isVector": true,
            "sourceLayer": "wdpa",
            "sourceUrl": "pmtiles://https://s3-west.nrp-nautilus.io/public-pmtiles/wdpa.pmtiles",
            "dataTablePath": "s3://public-wdpa/hex/**",
            "description": "World Database on Protected Areas showing global protected area boundaries",
            "filterableProperties": {
                "NAME_ENG": {
                    "type": "string",
                    "description": "Site name in English"
                },
                "NAME": {
                    "type": "string",
                    "description": "Site name (original)"
                },
                "DESIG_ENG": {
                    "type": "string",
                    "description": "Designation type in English"
                },
                "DESIG_TYPE": {
                    "type": "string",
                    "description": "Designation type category"
                },
                "IUCN_CAT": {
                    "type": "string",
                    "description": "IUCN management category",
                    "values": [
                        "Ia",
                        "Ib",
                        "II",
                        "III",
                        "IV",
                        "V",
                        "VI",
                        "Not Reported",
                        "Not Applicable",
                        "Not Assigned"
                    ]
                },
                "ISO3": {
                    "type": "string",
                    "description": "ISO 3-letter country code"
                },
                "STATUS": {
                    "type": "string",
                    "description": "Current status (e.g., Designated, Proposed)"
                },
                "STATUS_YR": {
                    "type": "number",
                    "description": "Year of status"
                },
                "GOV_TYPE": {
                    "type": "string",
                    "description": "Governance type"
                },
                "OWN_TYPE": {
                    "type": "string",
                    "description": "Ownership type"
                },
                "GIS_AREA": {
                    "type": "number",
                    "description": "GIS-calculated area in km²"
                },
                "REP_AREA": {
                    "type": "number",
                    "description": "Reported area in km²"
                },
                "MARINE": {
                    "type": "string",
                    "description": "Marine designation (0, 1, 2)"
                },
                "NO_TAKE": {
                    "type": "string",
                    "description": "No-take zone status"
                }
            }
        },
        "hydrobasins": {
            "displayName": "Watersheds (HydroBASINS L6)",
            "layerIds": [
                "hydrobasins-fill",
                "hydrobasins-layer"
            ],
            "checkboxId": "hydrobasins-layer",
            "hasLegend": false,
            "isVector": true,
            "sourceLayer": "hydrobasins_level_06",
            "sourceUrl": "pmtiles://https://s3-west.nrp-nautilus.io/public-pmtiles/hydrobasins_level_06.pmtiles",
            "dataTablePath": "s3://public-hydrobasins/level_06/hexes/**",
            "description": "Level 6 watershed basins from HydroBASINS showing drainage areas",
            "filterableProperties": {
                "HYBAS_ID": {
                    "type": "number",
                    "description": "Unique basin identifier"
                },
                "PFAF_ID": {
                    "type": "number",
                    "description": "Pfafstetter hierarchical code"
                },
                "UP_AREA": {
                    "type": "number",
                    "description": "Upstream drainage area in km²"
                },
                "SUB_AREA": {
                    "type": "number",
                    "description": "Sub-basin area in km²"
                },
                "MAIN_BAS": {
                    "type": "number",
                    "description": "Main basin ID"
                }
            }
        }
    }
}